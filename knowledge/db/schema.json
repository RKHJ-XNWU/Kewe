{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KeweAccountKnowledgeDatabase",
  "type": "object",
  "required": [
    "version",
    "seedVersion",
    "updatedAt",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "seedVersion": {
      "type": "integer"
    },
    "updatedAt": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "collection",
          "title",
          "tags",
          "file",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{2,64}$"
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{2,32}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "file": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      }
    }
  }
}
